APP_NAME="PHP Zoeker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Amsterdam

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokaal: sqlite. Productie / Docker Compose: pgsql (PostgreSQL 16 + pgvector).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=phpzoeker
# DB_USERNAME=phpzoeker
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live AI-meter: reverb (optioneel). Zonder websockets valt de meter terug op polling.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Lokaal: database. Productie: redis (+ Horizon).
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# AI-agent: provider, sleutel en modellen staan in Instellingen -> AI-agent (database, versleuteld).
# Onderstaande waarden zijn alleen een startwaarde bij de eerste installatie (seeder).
AI_BOOTSTRAP_PROVIDER=ollama
AI_BOOTSTRAP_BASE_URL=https://ollama.com
AI_BOOTSTRAP_API_KEY=
AI_BOOTSTRAP_MODEL=

# Uitgaande mail (SMTP-fallback van OutboundMailer). Bij Gmail: app-wachtwoord gebruiken.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Ontvanger van systeemmeldingen/testmails tijdens ontwikkeling
MAIL_TEST_RECIPIENT=

# Eerste beheerder (seeder). Wachtwoord leeg = willekeurig wachtwoord, getoond bij seeden.
ADMIN_EMAIL=michel@fremen.app
ADMIN_NAME=Michel
ADMIN_PASSWORD=

PDF_CONVERTER=auto
GOTENBERG_URL=http://localhost:3000
PDOK_LOCATIESERVER_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1

VITE_APP_NAME="${APP_NAME}"

# Inloggen alleen met 2FA (zet alleen lokaal op false)
REQUIRE_MFA=true
